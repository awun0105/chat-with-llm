# Copy to app/.env. Never expose the API key in browser-side code.
NVIDIA_API_KEY=
BASE_URL=https://integrate.api.nvidia.com/v1

# Add these only when models.toml references the matching provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Two large slots and two small slots served through NVIDIA NIM.
BIG_MODEL1=nvidia/nemotron-3-ultra-550b-a55b
BIG_MODEL2=openai/gpt-oss-20b
LAB_MINI_MODEL1=nvidia/nemotron-3-super-120b-a12b
LAB_MINI_MODEL2=deepseek-ai/deepseek-v4-flash-0731

# Accepts a slot ID or one of the full model IDs above.
DEFAULT_CHAT_MODEL=small-model-1
MAX_COMPLETION_TOKENS=2048

# Optional: point to another catalog, relative to the repository root or absolute.
# MODELS_CONFIG_PATH=app/models.toml
